# Telegram Bot API token. Obtain it from @BotFather.
TELEGRAM_BOT_TOKEN=

# Google Sheets document ID from its URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Path to Google service-account JSON credentials.
# Keep the real file outside Git and never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Alternatively, provide the complete service-account JSON on one line.
# If set, this takes precedence over GOOGLE_SERVICE_ACCOUNT_FILE.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Optional worksheet title. The worksheet will be created if it does not exist.
GOOGLE_SHEETS_WORKSHEET=Transactions
