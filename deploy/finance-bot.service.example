[Unit]
Description=Finance Bot Telegram service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=financebot
Group=financebot
WorkingDirectory=/opt/finance-bot
EnvironmentFile=/opt/finance-bot/.env
ExecStart=/opt/finance-bot/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
